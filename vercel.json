{
  "version": 2,
  "rewrites": [
    {
      "source": "/hook/:path*",
      "destination": "/api/webhook"
    },
    {
      "source": "/api/webhook",
      "destination": "/api/webhook"
    },
    {
      "source": "/api/index",
      "destination": "/api/index"
    },
    {
      "source": "/api/manage",
      "destination": "/api/manage"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/webhook"
    }
  ]
}
