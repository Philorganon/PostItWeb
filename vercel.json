{
  "version": 2,
  "builds": [
    {
      "src": "web-backend/api/webhook.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "web-backend/api/webhook.py"
    },
    {
      "src": "/hook/(.*)",
      "dest": "web-backend/api/webhook.py"
    },
    {
      "src": "/(.*)",
      "dest": "web-frontend/$1"
    }
  ]
}
