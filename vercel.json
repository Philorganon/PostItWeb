{
  "version": 2,
  "builds": [
    {
      "src": "web-backend/api/webhook.py",
      "use": "@vercel/python"
    }
  ],
  "rewrites": [
    { "source": "/api/:path*", "destination": "web-backend/api/webhook.py" },
    { "source": "/hook/:path*", "destination": "web-backend/api/webhook.py" },
    { "source": "/(.*)", "destination": "/web-frontend/$1" }
  ]
}
